<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. Both layers come from tools/generate_images.py:
    background = the flat colour of the generated icon (values/ic_launcher_background.xml)
    foreground = the generated icon, scaled so that the emblem stays inside the safe zone
    monochrome = the emblem alone (white on transparent) for Android 13+ themed icons
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
