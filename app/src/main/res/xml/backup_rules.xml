<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older (there, one set of rules covers cloud backup and device transfer).
  Nothing is backed up: the app promises that the data stays on the phone.
  Moving to a new phone works with the CSV export / import.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
