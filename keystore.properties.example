# Copy this file to "keystore.properties" (same folder) on the BUILD PC and fill it in.
# "keystore.properties" and the keystore file are git-ignored: never commit them, this repo is public.
#
# storeFile is relative to the project root. Keep the keystore OUTSIDE the repo if you can,
# for example:  storeFile=../keys/odolog-upload.jks
storeFile=../keys/odolog-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
